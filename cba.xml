      <guid isPermaLink="true">https://news.zhibo8.com/nba/2026-11-19/6afef27f4e8adnative.htm</guid>
      <pubDate>Thu, 19 Nov 2026 21:00:37 +0800</pubDate>
      <category>CBA</category>
    </item>
